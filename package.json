{
  "name": "gjms-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build",
    "preview": "vite preview --port 4173",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sitemap": "node scripts/generate-sitemap.js",
    "cf:plan": "node scripts/cloudflare/cloudflare.mjs plan",
    "cf:apply": "node scripts/cloudflare/cloudflare.mjs apply",
    "cf:verify": "node scripts/cloudflare/cloudflare.mjs verify"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.55.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
