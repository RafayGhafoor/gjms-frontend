# macOS
.DS_Store

# Node / SvelteKit build artefacts
node_modules/
.svelte-kit/
build/
*.log

# Environment (FTP credentials for gjms-automation live here — never commit)
.env

# Local journal data mirror and parser fixtures (not part of the website)
bunny-content/
test_files/
__pycache__/

# Apache/ftp leftovers from the old static hosting
.htaccess

# NOTE: do not ignore *.pdf — the journal publishes policy documents (for example
# the publication-ethics PDF) alongside the HTML pages, and an ignored PDF cannot
# be committed or deployed. Research articles stay on the Bunny CDN and are
# referenced by URL, so they are never copied into this repository.
